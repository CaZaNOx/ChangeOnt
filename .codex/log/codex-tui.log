+def line_chart_png(path: Path, series: Dict[str, Sequence[float]], title: str, xlabel: str, ylabel: str) -> None:
+    if not series:
+        return
+    width = 500
+    height = 340
+    canvas = _init_canvas(width, height)
+    margin_l = 60
+    margin_b = 70
+    margin_t = 40
+    margin_r = 20
+    plot_w = width - margin_l - margin_r
+    plot_h = height - margin_t - margin_b
+    _fill_rect(canvas, margin_l, margin_t, plot_w, plot_h, (40, 40, 45))
+    _draw_text(canvas, margin_l + 4, 6, title, (255, 255, 255))
+    _draw_text(canvas, width - margin_r - len(ylabel) * 6, margin_t + 6, ylabel, (255, 255, 255))
+    max_val = 0.0
+    max_len = 0
+    for vals in series.values():
+        if vals:
+            max_val = max(max_val, max(vals))
+            max_len = max(max_len, len(vals))
+    if max_val <= 0:
+        max_val = 1.0
+    if max_len == 0:
+        return
+    for idx, (agent, values) in enumerate(series.items()):
+        color = (80 + (idx * 47) % 100, 120 + (idx * 67) % 60, 180 - (idx * 37) % 60)
+        prev_x = prev_y = None
+        for i, val in enumerate(values):
+            x = margin_l + int(i / max_len * plot_w)
+            y = height - margin_b - int((val / max_val) * plot_h)
+            if prev_x is not None:
+                _draw_line(canvas, prev_x, prev_y, x, y, color)
+            prev_x, prev_y = x, y
+        _draw_text(canvas, prev_x, prev_y - 6, agent, color)
+    _write_png(path, canvas)
+
+def _draw_line(canvas: List[List[Color]], x0: int, y0: int, x1: int, y1: int, color: Color) -> None:
+    dx = abs(x1 - x0)
+    dy = -abs(y1 - y0)
+    sx = 1 if x0 < x1 else -1
+    sy = 1 if y0 < y1 else -1
+    err = dx + dy
+    while True:
+        _set_pixel(canvas, x0, y0, color)
+        if x0 == x1 and y0 == y1:
+            break
+        e2 = 2 * err
+        if e2 >= dy:
+            err += dy
+            x0 += sx
+        if e2 <= dx:
+            err += dx
+            y0 += sy

+id: stmt.cl-cross-ai-evidence
+type: CL
+title: Cross-AI audits require verbatim evidence counts
+dependencies: ["[[01_Statements/Clarification/S-CL-cross-ai-predictions]]"]
+parents: []
+successors: []
+concepts: ["[[02_Concepts/C-ontology-of-change]]"]

+from typing import Dict, Any, List
+import csv
+
+from experiments.plotting.raster import bar_chart_png, line_chart_png
+
+def ensure_dir(p: Path) -> None:
+    p.mkdir(parents=True, exist_ok=True)
+
+def write_csv(path: Path, rows: List[Dict[str, Any]]) -> None:
+    if not rows:
+        path.write_text("", encoding="utf-8")
+        return
+    keys = list(rows[0].keys())
+    with path.open("w", newline="", encoding="utf-8") as f:
+        w = csv.DictWriter(f, fieldnames=keys)
+        w.writeheader()
+        for r in rows:
+            w.writerow(r)
+
+class _FallbackPlt:
+    def __init__(self) -> None:
+        self.reset()
+
+    def reset(self) -> None:
+        self.series: Dict[str, List[float]] = {}
+        self.bars: Dict[str, float] = {}
+        self.xlabel_text = ""
+        self.ylabel_text = ""
+        self.title_text = ""
+        self.xtick_labels: List[str] = []
+        self.xtick_positions: List[int] = []
+        self.legend_labels: List[str] = []
+
+    def figure(self) -> None:
+        self.reset()
+
+    def plot(self, x: Sequence[float], y: Sequence[float], label: str | None = None, linewidth: float = 1.0) -> None:
+        if not label:
+            label = f"series_{len(self.series)}"
+        self.series[label] = list(y)
+
+    def bar(self, positions: Sequence[int], heights: Sequence[float], label: str | None = None) -> None:
+        if label is None:
+            label = f"bar_{len(self.bars)}"
+        avg = sum(heights) / len(heights) if heights else 0.0
+        self.bars[label] = float(avg)
+
+    def xticks(self, positions: Sequence[int], labels: Sequence[str], rotation: float = 0, ha: str | None = None) -> None:
+        self.xtick_positions = list(positions)
+        self.xtick_labels = list(labels)
+
+    def xlabel(self, text: str) -> None:
+        self.xlabel_text = text
+
+    def ylabel(self, text: str) -> None:
+        self.ylabel_text = text
+
+    def title(self, text: str) -> None:
+        self.title_text = text
+
+    def legend(self) -> None:
+        self.legend_labels = list(self.series.keys())
+
+    def tight_layout(self) -> None:
+        pass
+
+    def savefig(self, path: Path, dpi: int | None = None) -> None:
+        if self.bars:
+            labels = list(self.bars.keys())
+            vals = list(self.bars.values())
+            bar_chart_png(path, labels, vals, self.title_text or "chart", self.ylabel_text or "")
+        elif self.series:
+            line_chart_png(path, self.series, self.title_text or "chart", self.xlabel_text or "x", self.ylabel_text or "y")
+        self.reset()
+
+    def close(self) -> None:
+        self.reset()
+
+def safe_import_plt():
+    try:
+        import matplotlib.pyplot as plt  # type: ignore
+        return plt
+    except Exception:
+        return _FallbackPlt()

+def _set_pixel(pixels: List[List[tuple[int, int, int]]], x: int, y: int, color: tuple[int, int, int]) -> None:
+    if 0 <= y < len(pixels) and 0 <= x < len(pixels[0]):
+        pixels[y][x] = color
+
+def _fill_rect(pixels: List[List[tuple[int, int, int]]], x: int, y: int, w: int, h: int, color: tuple[int, int, int]) -> None:
+    for yy in range(y, y + h):
+        for xx in range(x, x + w):
+            _set_pixel(pixels, xx, yy, color)
+
+def _draw_text(pixels: List[List[tuple[int, int, int]]], x: int, y: int, text: str, color: tuple[int, int, int]) -> None:
+    cursor = x
+    for ch in text.upper():
+        pattern = FONT.get(ch, FONT.get(" ", []))
+        for col_idx, col in enumerate(pattern):
+            for row in range(7):
+                if (col >> row) & 1:
+                    _set_pixel(pixels, cursor + col_idx, y + row, color)
+        cursor += 6
+
+def _write_png(path: Path, pixels: List[List[tuple[int, int, int]]]) -> None:
+    height = len(pixels)
+    width = len(pixels[0]) if height else 0
+    def png_chunk(tag: bytes, data: bytes) -> bytes:
+        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
+    raw = bytearray()
+    for row in pixels:
+        raw.append(0)
+        for r, g, b in row:
+            raw.extend((r, g, b))
+    compressed = zlib.compress(bytes(raw), level=6)
+    with path.open("wb") as f:
+        f.write(b"\x89PNG\r\n\x1a\n")
+        f.write(png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
+        f.write(png_chunk(b"IDAT", compressed))
+        f.write(png_chunk(b"IEND", b""))
+
+def _write_bar_chart_png(out_path: Path, labels: List[str], values: List[float], title: str, ylabel: str) -> None:
+    if not labels or not values:
+        return
+    width = max(480, 80 * len(labels))
+    height = 320
+    pixels = [[(255, 255, 255) for _ in range(width)] for _ in range(height)]
+    margin_l = 60
+    margin_b = 80
+    margin_t = 40
+    margin_r = 20
+    plot_w = width - margin_l - margin_r
+    plot_h = height - margin_t - margin_b
+    vmax = max(values) if values else 1.0
+    vmax = vmax if vmax > 0 else 1.0
+    bar_w = plot_w / max(1, len(values))
+    _fill_rect(pixels, margin_l, margin_t, plot_w, plot_h, (230, 230, 230))
+    for idx, (lab, val) in enumerate(zip(labels, values)):
+        x = int(margin_l + idx * bar_w + bar_w * 0.1)
+        w = max(1, int(bar_w * 0.8))
+        h = int((val / vmax) * plot_h)
+        y = int(height - margin_b - h)
+        _fill_rect(pixels, x, y, w, max(1, h), (76, 120, 168))
+        _draw_text(pixels, x, height - margin_b + 6, lab, (0, 0, 0))
+    _draw_text(pixels, width // 2 - int(len(title) * 3), 8, title, (0, 0, 0))
+    _draw_text(pixels, 2, height // 2 - 10, ylabel, (0, 0, 0))
+    _write_png(out_path, pixels)
+
+def _write_family_panel_png(out_path: Path, fams: List[str], rows_by_family: Dict[str, List[Dict[str, Any]]], title: str) -> None:
+    if not fams:
+        return
+    panel_w = 320
+    panel_h = 260
+    width = panel_w * len(fams)
+    height = panel_h
+    pixels = [[(255, 255, 255) for _ in range(width)] for _ in range(height)]
+    _draw_text(pixels, width // 2 - int(len(title) * 3), 10, title, (0, 0, 0))
+    for idx, fam in enumerate(fams):
+        rows = rows_by_family.get(fam, [])
+        labels = [r["agent"] for r in rows]
+        values = [float(r["normalized_score"]) for r in rows]
+        if not values:
+            continue
+        margin_l = 40
+        margin_b = 60
+        margin_t = 30
+        margin_r = 10
+        plot_w = panel_w - margin_l - margin_r
+        plot_h = panel_h - margin_t - margin_b
+        base_x = idx * panel_w
+        _draw_text(pixels, base_x + panel_w // 2 - int(len(fam) * 3), 24, fam, (0, 0, 0))
+        vmax = max(values) if values else 1.0
+        vmax = vmax if vmax > 0 else 1.0
+        bar_w = plot_w / max(1, len(values))
+        for i, (lab, val) in enumerate(zip(labels, values)):
+            x = int(base_x + margin_l + i * bar_w + bar_w * 0.1)
+            w = max(1, int(bar_w * 0.8))
+            h = int((val / vmax) * plot_h)
+            y = panel_h - margin_b - h
+            _fill_rect(pixels, x, y, w, max(1, h), (114, 183, 178))
+            _draw_text(pixels, x, panel_h - margin_b + 6, lab, (0, 0, 0))
+    _write_png(out_path, pixels)

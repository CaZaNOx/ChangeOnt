+
+def _write_bar_svg(out_path: Path, labels: List[str], values: List[float], title: str, ylabel: str) -> None:
+    if not labels or not values:
+        return
+    n = len(labels)
+    width = max(480, 80 * n)
+    height = 320
+    margin_l = 60
+    margin_b = 80
+    margin_t = 40
+    margin_r = 20
+    plot_w = width - margin_l - margin_r
+    plot_h = height - margin_t - margin_b
+    vmax = max(values) if values else 1.0
+    vmax = vmax if vmax > 0 else 1.0
+    bar_w = plot_w / max(1, n)
+    svg = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}">',
+        f'<rect x="0" y="0" width="{width}" height="{height}" fill="white"/>',
+        f'<text x="{width/2:.1f}" y="{margin_t/2:.1f}" text-anchor="middle" font-size="14">{title}</text>',
+        f'<text x="{margin_l/2:.1f}" y="{height/2:.1f}" text-anchor="middle" font-size="12" transform="rotate(-90 {margin_l/2:.1f},{height/2:.1f})">{ylabel}</text>',
+        f'<line x1="{margin_l}" y1="{margin_t}" x2="{margin_l}" y2="{height-margin_b}" stroke="black" stroke-width="1"/>',
+        f'<line x1="{margin_l}" y1="{height-margin_b}" x2="{width-margin_r}" y2="{height-margin_b}" stroke="black" stroke-width="1"/>',
+    ]
+    for i, (lab, val) in enumerate(zip(labels, values)):
+        x = margin_l + i * bar_w + bar_w * 0.1
+        w = bar_w * 0.8
+        h = (val / vmax) * plot_h
+        y = height - margin_b - h
+        svg.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" fill="#4C78A8"/>')
+        svg.append(f'<text x="{x + w/2:.1f}" y="{height - margin_b + 16:.1f}" text-anchor="middle" font-size="10" transform="rotate(30 {x + w/2:.1f},{height - margin_b + 16:.1f})">{lab}</text>')
+    svg.append("</svg>")
+    out_path.write_text("\n".join(svg), encoding="utf-8")
+
+def _write_family_panel_svg(out_path: Path, fams: List[str], rows_by_family: Dict[str, List[Dict[str, Any]]], title: str) -> None:
+    if not fams:
+        return
+    panel_w = 320
+    panel_h = 260
+    width = panel_w * len(fams)
+    height = panel_h
+    svg = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}">',
+        f'<rect x="0" y="0" width="{width}" height="{height}" fill="white"/>',
+        f'<text x="{width/2:.1f}" y="18" text-anchor="middle" font-size="14">{title}</text>',
+    ]
+    for idx, fam in enumerate(fams):
+        rows = rows_by_family.get(fam, [])
+        labels = [r["agent"] for r in rows]
+        values = [float(r["normalized_score"]) for r in rows]
+        n = len(labels)
+        margin_l = 40
+        margin_b = 60
+        margin_t = 30
+        margin_r = 10
+        plot_w = panel_w - margin_l - margin_r
+        plot_h = panel_h - margin_t - margin_b
+        base_x = idx * panel_w
+        svg.append(f'<text x="{base_x + panel_w/2:.1f}" y="{margin_t-10:.1f}" text-anchor="middle" font-size="12">{fam}</text>')
+        svg.append(f'<line x1="{base_x+margin_l}" y1="{margin_t}" x2="{base_x+margin_l}" y2="{panel_h-margin_b}" stroke="black" stroke-width="1"/>')
+        svg.append(f'<line x1="{base_x+margin_l}" y1="{panel_h-margin_b}" x2="{base_x+panel_w-margin_r}" y2="{panel_h-margin_b}" stroke="black" stroke-width="1"/>')
+        if n == 0:
+            continue
+        vmax = max(values) if values else 1.0
+        vmax = vmax if vmax > 0 else 1.0
+        bar_w = plot_w / max(1, n)
+        for i, (lab, val) in enumerate(zip(labels, values)):
+            x = base_x + margin_l + i * bar_w + bar_w * 0.1
+            w = bar_w * 0.8
+            h = (val / vmax) * plot_h
+            y = panel_h - margin_b - h
+            svg.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" fill="#72B7B2"/>')
+            svg.append(f'<text x="{x + w/2:.1f}" y="{panel_h - margin_b + 16:.1f}" text-anchor="middle" font-size="9" transform="rotate(30 {x + w/2:.1f},{panel_h - margin_b + 16:.1f})">{lab}</text>')
+    svg.append("</svg>")
+    out_path.write_text("\n".join(svg), encoding="utf-8")

+def d_bend(trace_a: List[int], trace_b: List[int]) -> float:
+    """
+    P1 BendMetric v1 (warped-Hamming with left padding).
+    See docs/kernel_spec/04_PRIMITIVES/P1_BendMetric.md.
+    """
+    L = 12
+    PAD_TOKEN = -1
+    pad_cost = 0.25
+    mismatch_cost = 1.0
+
+    a = list(trace_a or [])
+    b = list(trace_b or [])
+    if len(a) > L:
+        a = a[-L:]
+    if len(b) > L:
+        b = b[-L:]
+    if len(a) < L:
+        a = [PAD_TOKEN] * (L - len(a)) + a
+    if len(b) < L:
+        b = [PAD_TOKEN] * (L - len(b)) + b
+
+    total = 0.0
+    for x, y in zip(a, b):
+        if x == PAD_TOKEN and y == PAD_TOKEN:
+            continue
+        if x == PAD_TOKEN or y == PAD_TOKEN:
+            total += pad_cost
+        elif x == y:
+            continue
+        else:
+            total += mismatch_cost
+    return total / float(L)

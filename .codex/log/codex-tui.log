rue\n        use_translator: true\n        blend_mode: \"mix\"\n        classic_planner: \"greedy\"\n        co_weight_override: null\n        eps_on_cycle: 0.10\n        ngram_order: 2\n        greedy_explore_bias: 0.10\n    primitives:\n      co_bus: {}\n      P0: {}\n      bandit_stats: {}\n      ngram_model: {}\n    combinator:\n      order: [\"haq\",\"ghvc\",\"EC_Identity\",\"density\",\"change_ops\",\"vote_bridge\",\"action_head\"]\nseed: 0\nout: outputs/verify/qa_maze\nEOF","yield_time_ms":1000,"max_output_tokens":2000} thread_id=019c9b92-4551-7730-a36c-a30f295a6bf4

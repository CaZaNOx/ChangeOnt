+# experiments/plotting/raster.py
+from __future__ import annotations
+from typing import Dict, List, Sequence, Tuple
+from pathlib import Path
+import struct
+import zlib
+
+FONT: Dict[str, Sequence[int]] = {
+    "A": [0x1F, 0x05, 0x05, 0x1F, 0x00], "B": [0x1F, 0x15, 0x15, 0x0A, 0x00],
+    "C": [0x0E, 0x11, 0x11, 0x11, 0x00], "D": [0x1F, 0x11, 0x11, 0x0E, 0x00],
+    "E": [0x1F, 0x15, 0x15, 0x11, 0x00], "F": [0x1F, 0x05, 0x05, 0x01, 0x00],
+    "G": [0x0E, 0x11, 0x15, 0x1D, 0x00], "H": [0x1F, 0x04, 0x04, 0x1F, 0x00],
+    "I": [0x11, 0x1F, 0x11, 0x00, 0x00], "J": [0x08, 0x10, 0x10, 0x0F, 0x00],
+    "K": [0x1F, 0x04, 0x0A, 0x11, 0x00], "L": [0x1F, 0x10, 0x10, 0x10, 0x00],
+    "M": [0x1F, 0x02, 0x04, 0x02, 0x1F], "N": [0x1F, 0x02, 0x04, 0x1F, 0x00],
+    "O": [0x0E, 0x11, 0x11, 0x0E, 0x00], "P": [0x1F, 0x05, 0x05, 0x02, 0x00],
+    "Q": [0x0E, 0x11, 0x19, 0x1E, 0x00], "R": [0x1F, 0x05, 0x0D, 0x12, 0x00],
+    "S": [0x12, 0x15, 0x15, 0x09, 0x00], "T": [0x01, 0x1F, 0x01, 0x00, 0x00],
+    "U": [0x0F, 0x10, 0x10, 0x0F, 0x00], "V": [0x07, 0x08, 0x10, 0x08, 0x07],
+    "W": [0x1F, 0x08, 0x04, 0x08, 0x1F], "X": [0x11, 0x0A, 0x04, 0x0A, 0x11],
+    "Y": [0x01, 0x02, 0x1C, 0x02, 0x01], "Z": [0x19, 0x15, 0x13, 0x00, 0x00],
+    "0": [0x0E, 0x11, 0x11, 0x0E, 0x00], "1": [0x12, 0x1F, 0x10, 0x00, 0x00],
+    "2": [0x1D, 0x15, 0x15, 0x13, 0x00], "3": [0x11, 0x15, 0x15, 0x0A, 0x00],
+    "4": [0x07, 0x04, 0x04, 0x1F, 0x00], "5": [0x17, 0x15, 0x15, 0x09, 0x00],
+    "6": [0x0E, 0x15, 0x15, 0x09, 0x00], "7": [0x01, 0x19, 0x05, 0x03, 0x00],
+    "8": [0x0A, 0x15, 0x15, 0x0A, 0x00], "9": [0x12, 0x15, 0x15, 0x0E, 0x00],
+    "_": [0x10, 0x10, 0x10, 0x10, 0x00], "-": [0x04, 0x04, 0x04, 0x04, 0x00],
+    " ": [0x00, 0x00, 0x00, 0x00, 0x00],
+}
+
+Color = Tuple[int, int, int]
+
+def _set_pixel(canvas: List[List[Color]], x: int, y: int, color: Color) -> None:
+    if 0 <= y < len(canvas) and 0 <= x < len(canvas[0]):
+        canvas[y][x] = color
+
+def _fill_rect(canvas: List[List[Color]], x: int, y: int, w: int, h: int, color: Color) -> None:
+    for yy in range(y, min(len(canvas), y + h)):
+        for xx in range(x, min(len(canvas[0]), x + w)):
+            canvas[yy][xx] = color
+
+def _draw_text(canvas: List[List[Color]], x: int, y: int, text: str, color: Color) -> None:
+    cursor = x
+    for ch in text.upper():
+        pattern = FONT.get(ch, FONT[" "])
+        for col_idx, col in enumerate(pattern):
+            for row in range(7):
+                if (col >> row) & 1:
+                    _set_pixel(canvas, cursor + col_idx, y + row, color)
+        cursor += 6
+
+def _write_png(path: Path, canvas: List[List[Color]]) -> None:
+    height = len(canvas)
+    width = len(canvas[0]) if height else 0
+    raw = bytearray()
+    for row in canvas:
+        raw.append(0)
+        for r, g, b in row:
+            raw.extend((r, g, b))
+    compressed = zlib.compress(bytes(raw), level=6)
+    def chunk(tag: bytes, data: bytes) -> bytes:
+        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
+    with path.open("wb") as f:
+        f.write(b"\x89PNG\r\n\x1a\n")
+        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
+        f.write(chunk(b"IDAT", compressed))
+        f.write(chunk(b"IEND", b""))
+
+def _init_canvas(width: int, height: int) -> List[List[Color]]:
+    canvas = [[(25, 25, 25) for _ in range(width)] for _ in range(height)]
+    for y in range(height):
+        blend = int(10 + 200 * (y / height))
+        for x in range(width):
+            canvas[y][x] = (blend, blend, blend + 5)
+    return canvas
+
+def bar_chart_png(path: Path, labels: Sequence[str], values: Sequence[float], title: str, ylabel: str) -> None:
+    if not labels or not values:
+        return
+    width = max(480, 90 * len(labels))
+    height = 320
+    canvas = _init_canvas(width, height)
+    margin_l = 60
+    margin_b = 70
+    margin_t = 40
+    margin_r = 20
+    plot_w = width - margin_l - margin_r
+    plot_h = height - margin_t - margin_b
+    _fill_rect(canvas, margin_l, margin_t, plot_w, plot_h, (50, 50, 60))
+    _draw_text(canvas, margin_l + 4, 6, title, (255, 255, 255))
+    _draw_text(canvas, width - margin_r - len(ylabel) * 6, margin_t + 6, ylabel, (255, 255, 255))
+    vmax = max(values)
+    if vmax <= 0:
+        vmax = 1.0
+    bar_w = plot_w / max(1, len(values))
+    for idx, (label, val) in enumerate(zip(labels, values)):
+        x = int(margin_l + idx * bar_w + bar_w * 0.1)
+        w = max(1, int(bar_w * 0.8))
+        h = int((val / vmax) * plot_h)

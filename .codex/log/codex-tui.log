+                if k not in headers:
+                    headers.append(k)
+        with out_co_overall.open("w", encoding="utf-8", newline="") as f:
+            w = csv.DictWriter(f, fieldnames=headers)
+            w.writeheader()
+            w.writerows(co_rows_overall)
+    else:
+        with out_co_overall.open("w", encoding="utf-8", newline="") as f:
+            w = csv.DictWriter(f, fieldnames=["agent", "overall_score"])

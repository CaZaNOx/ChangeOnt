+def summarize_family(suite_root: Path, family: str) -> None:
+    fam_root = suite_root / family
+    if not fam_root.exists():
+        return
+    if family == "bandit":
+        bandit_aggregate(fam_root)
+    elif family == "maze":
+        maze_aggregate(fam_root)
+    elif family == "renewal":
+        renewal_aggregate(fam_root)
